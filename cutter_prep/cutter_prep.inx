<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Flatten for Cutter…</name>
  <id>com.dansu.cutter_prep</id>

  <param name="tab" type="notebook">
    <page name="options" gui-text="Options">
      <param name="color_mode" type="optiongroup" appearance="combo" gui-text="Color handling:">
        <option value="per_color">Keep each color as its own cut layer</option>
        <option value="silhouette">Merge everything into one silhouette</option>
        <option value="white_holes">One silhouette, white areas become holes</option>
      </param>
      <param name="drop_white" type="bool" gui-text="Per-color mode: drop white/background regions">true</param>
      <param name="white_threshold" type="int" min="200" max="255" gui-text="White threshold (each RGB channel ≥):">240</param>

      <separator/>
      <param name="output_style" type="optiongroup" appearance="combo" gui-text="Output style:">
        <option value="stroke">Hairline stroke, no fill (cut lines)</option>
        <option value="fill">Solid fill, no stroke (shapes)</option>
      </param>
      <param name="hairline_mm" type="float" min="0.01" max="1.0" precision="3" gui-text="Hairline width (mm):">0.1</param>

      <separator/>
      <param name="color_tolerance" type="int" min="0" max="128" gui-text="Treat colors as the same if each RGB channel is within:">40</param>
      <param name="min_width" type="float" min="0.0" max="5.0" precision="2" gui-text="Remove slivers thinner than (mm):">0.25</param>
      <param name="min_area" type="float" min="0.0" max="100.0" precision="3" gui-text="Remove fragments smaller than (mm²):">0.02</param>
      <param name="show_report" type="bool" gui-text="Show summary report when done">true</param>
    </page>
    <page name="help" gui-text="Help">
      <label appearance="header">What this does</label>
      <label>Converts every visible stroke to its outline, removes parts hidden behind other objects (Path &gt; Flatten), merges regions, and outputs clean paths that match what you see on screen.</label>
      <label>Requires Inkscape 1.4 or newer. The whole run is a single undo step (Ctrl/Cmd+Z).</label>
      <label>Clips, masks, markers and transparency are reported as warnings; check those areas after the run.</label>
    </page>
  </param>

  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Cutter Prep"/>
    </effects-menu>
  </effect>

  <script>
    <command location="inx" interpreter="python">cutter_prep.py</command>
  </script>
</inkscape-extension>
